# Variables de la composición de producción (infra/docker-compose.prod.yml).
# En AWS este archivo lo genera infra/cargar-secretos.sh desde SSM Parameter Store
# (ruta /rutas-accesibles/prod/). Copie como .env.prod para una prueba manual; nunca lo suba a git.

# Imágenes: ${REGISTRO}/<servicio>:${ETIQUETA}
#   local: REGISTRO=rutas-accesibles, ETIQUETA=local
#   ECR:   REGISTRO=<cuenta>.dkr.ecr.us-east-1.amazonaws.com/rutas-accesibles
REGISTRO=rutas-accesibles
ETIQUETA=local

# Dominio público. Vacío: HTTP en el puerto 80 (para probar con la IP).
# Con dominio: HTTPS automático con Let's Encrypt (el DNS debe apuntar a la instancia)
DOMINIO=
# Origen que ve el navegador (para CORS de respaldo): http://<IP> o https://<dominio>
ORIGEN_PUBLICO=http://localhost

# Base de datos
POSTGRES_DB=rutas
POSTGRES_USER=rutas
POSTGRES_PASSWORD=

# Seguridad del administrador (ver docs/seguridad.md)
# JWT_SECRETO: mínimo 32 bytes. Genérelo con: openssl rand -base64 48
JWT_SECRETO=
ADMIN_CORREO=
ADMIN_CONTRASENA=

# Puertos publicados por Caddy (opcional)
# PUERTO_HTTP=80
# PUERTO_HTTPS=443
