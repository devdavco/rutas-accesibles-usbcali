# Copie este archivo como .env y complete las credenciales (el .env no se sube al repositorio)
POSTGRES_DB=rutas
POSTGRES_USER=
POSTGRES_PASSWORD=
DB_PORT=5432

# Seguridad del administrador (servicio-negocio)
# Secreto para firmar los JWT (HS256, mínimo 32 bytes). Genérelo con: openssl rand -base64 48
JWT_SECRETO=
# Administrador inicial: se crea al arrancar si no existe
ADMIN_CORREO=
ADMIN_CONTRASENA=
